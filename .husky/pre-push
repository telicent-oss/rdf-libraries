#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

./scripts/cp-LICENSE-root-to-packages.sh
./scripts/check-release-please-config/index.js
yarn test

# release-please bumps its registered packages - but doesn't publish certain private
# packages to npmjs.org. For the unpublished, verify-dist rebuilds and compares against
# the committed ./dist, so a version bump that didnt get a rebuild fails the build.
yarn lerna run verify-dist
