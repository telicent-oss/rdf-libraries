{
  "name": "@telicent-oss/git-pull-ignored-lib",
  "version": "0.0.1",
  "private": true,
  "//private": "private until we get an npmjs.org package created",
  "license": "Apache-2.0",
  "description": "Pull a subdirectory of a git repository into a local gitignored directory, refusing any destination git does not ignore.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "!src/*.test.js",
    "!src/**/*.test.js",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src/",
    "tscNoEmit": "echo \"no TypeScript in this package\"",
    "build": "echo \"No-op: Nothing to build\""
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "vitest": "^4.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/telicent-oss/rdf-libraries.git",
    "directory": "packages/git-pull-ignored-lib"
  }
}
