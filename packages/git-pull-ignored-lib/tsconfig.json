{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext", // Important for ESM support
    "target": "ESNext", // Compile to a modern ECMAScript version
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // types: this package runs in node; no sibling needs the node globals.
  // No ts-node block: the siblings carry one; nothing here is run through ts-node.
  "include": ["src/**/*.ts"],
  // The tests are typechecked by tsconfig.spec.json, which adds the jest types.
  "exclude": ["src/**/*.test.ts"]
}
