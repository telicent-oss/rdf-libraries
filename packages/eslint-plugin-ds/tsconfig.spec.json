{
  "// WHY does this file exist?": "compilerOptions.module = 'CommonJS'",
  "// WHY is that important?": "Jest works better with CommonJS",
  "// WHEN can it be removed?": "When tests work with ESM",
  "// MORE:": "https://jestjs.io/docs/ecmascript-modules",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["jest", "node"]
  },
  "// exclude": "cleared: extends would inherit the parent exclude, which drops the tests this project exists for",
  "exclude": [],
  "include": ["src/**/*.ts"]
}
