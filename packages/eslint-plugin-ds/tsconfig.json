{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext", // Important for ESM support
    "target": "ESNext", // Compile to a modern ECMAScript version
    // bundler, not node: @typescript-eslint/types publishes its declarations through an
    // exports map, which classic node resolution cannot read.
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  // types: this package runs in node, so it asks for the node globals. Other packages in
  // this monorepo do not, which is why the setting is here and not in tsconfig.base.json.
  // No ts-node block: other packages here carry one; nothing in this package runs under
  // ts-node.
  "include": ["src/**/*.ts"],
  // The tests are typechecked by tsconfig.spec.json, which adds the jest types.
  "exclude": ["src/**/*.test.ts"]
}
