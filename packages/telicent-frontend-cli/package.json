{
  "name": "@telicent-oss/telicent-frontend-cli",
  "type": "module",
  "version": "1.5.0",
  "scripts": {
    "build": "rm -rf ./dist && tsc && chmod +x ./dist/bin/tefe.js",
    "build:watch": "chokidar 'src/**/*.ts' -c 'pnpm build'",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "prepare": "pnpm build && husky",
    "test": "FORCE_COLOR=0 vitest --watch=false",
    "test:watch": "vitest",
    "format": "prettier ./src -c",
    "format:write": "pnpm format --write ./src",
    "lint": "eslint -c eslint.config.cjs . ",
    "lint:fix": "eslint -c eslint.config.cjs . --fix",
    "readme": "node ./scripts/updateReadmeWithTefeHelpCommand.js",
    "relink": "(pnpm unlink --global || ./scripts/forceUnlink.cjs) && pnpm link --global",
    "bump": "./scripts/bump.sh",
    "bump:prerelease": "pnpm version prerelease && git push && git push --tags",
    "bump:pre": "pnpm bump:prerelease"
  },
  "bin": {
    "tefe": "./dist/bin/tefe.js"
  },
  "description": "A CLI for FE engineers",
  "main": "./dist/index.js",
  "keywords": [
    "cli",
    "telicent"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/telicent-oss/telicent-frontend-cli"
  },
  "dependencies": {
    "@commander-js/extra-typings": "12.0.1",
    "@types/update-notifier": "^6.0.8",
    "commander": "12.0.0",
    "memfs": "4.9.2",
    "update-notifier": "6.0.2",
    "yaml": "2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitest/coverage-v8": "^2.1.9",
    "chalk": "^5.4.1",
    "chokidar-cli": "3.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "9.0.11",
    "prettier": "^3.3.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "engine": {
    "node": "20.14.0"
  }
}
